        "messages": {
          "values": [
            {
              "content": "=You are an email triage classifier for a real-estate company's inbox.\n\nClassify the following email into ONE of these categories:\ngeneral_query, sales_inquiry, job_application, project_related, internal_communication, meeting_request, urgent_request, complaint, promotional, spam, other\n\nAlso assign a priority: low, medium, high\nAnd decide requires_human: true or false\n\nRespond ONLY with valid JSON in this exact format, no other text:\n{\n  \"category\": \"...\",\n  \"priority\": \"...\",\n  \"requires_human\": true/false,\n  \"reasoning\": \"one short sentence\"\n}\n\nEmail subject: {{ $('Gmail Trigger').item.json.subject }}\nEmail from: {{ $('Gmail Trigger').item.json.from.text }}\nEmail body: {{ $('Gmail Trigger').item.json.text }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.1,
      "position": [
        560,
        16
      ],
      "id": "ff55002e-fb40-4f49-a8c7-e65fd48c385f",
      "name": "Message a model",
      "credentials": {
        "googlePalmApi": {
          "id": "FFkoZYVqMhwGNcD4",
          "name": "Google Gemini(PaLM) Api account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.content.parts[0].text;\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  parsed = {\n    category: \"other\",\n    priority: \"medium\",\n    requires_human: true,\n    reasoning: \"Failed to parse AI response\"\n  };\n}\n\n// Group categories into simple routing buckets\nconst routeMap = {\n  general_query: \"rag\",\n  sales_inquiry: \"rag\",\n  job_application: \"hr\",\n  project_related: \"manager\",\n  internal_communication: \"manager\",\n  complaint: \"manager\",\n  meeting_request: \"meeting\",\n  urgent_request: \"urgent\",\n  promotional: \"archive\",\n  spam: \"archive\",\n};\nparsed.route = routeMap[parsed.category] || \"human_review\";\n\nconst emailData = $('Gmail Trigger').first().json; // check your actual node name\n\nreturn [{\n  json: {\n    ...parsed,\n    subject: emailData.subject,\n    from: emailData.from.text,\n    to: emailData.to.text,\n    messageId: emailData.messageId,\n    body: emailData.text\n  }\n}];"
      },
